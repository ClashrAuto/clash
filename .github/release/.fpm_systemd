-s dir
--name coast
--category net
--license GPL-3.0-or-later
--description "The universal proxy platform."
--url "https://wiki.metacubex.one/"
--maintainer "MetaCubeX <none@example.com>"
--deb-field "Bug: https://github.com/ClashrAuto/coast/issues"
--no-deb-generate-changes
--config-files /etc/coast/config.yaml

.github/release/config.yaml=/etc/coast/config.yaml

.github/release/coast.service=/usr/lib/systemd/system/coast.service
.github/release/coast@.service=/usr/lib/systemd/system/coast@.service


LICENSE=/usr/share/licenses/coast/LICENSE